{
  "name": "@jackochesstern/upstage-cli",
  "version": "3.1.0",
  "description": "Agentic coding assistant powered by Upstage Solar Pro2 — TUI, 30 built-in tools, MCP support, evaluation harness",
  "license": "MIT",
  "author": "VectorSophie",
  "homepage": "https://github.com/VectorSophie/upstage-cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/VectorSophie/upstage-cli.git"
  },
  "bugs": {
    "url": "https://github.com/VectorSophie/upstage-cli/issues"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "agent",
    "cli",
    "tui",
    "upstage",
    "solar",
    "llm",
    "mcp",
    "swe-bench"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "src/",
    "skills/",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "upstage": "src/cli/index.mjs",
    "upstage-mcp": "src/mcp/upstage-server.mjs",
    "upstage-bridge": "src/bridge/server.mjs"
  },
  "scripts": {
    "dev": "bun src/cli/index.mjs",
    "start": "bun src/cli/index.mjs",
    "check": "node --check src/cli/index.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:ui": "bun test tests/opentui/",
    "lint": "eslint src/ tests/ scripts/",
    "smoke": "node scripts/smoke.mjs",
    "ci": "npm run check && npm run lint && npm test && npm run test:ui && npm run smoke"
  },
  "dependencies": {
    "@opentui/core": "0.5.1",
    "@opentui/react": "0.5.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "chalk": "^4.1.2",
    "react": "^19.2.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "0.25.10",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0"
  }
}
